  "item": [
    {
      "name": "accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const newAccountId = response?.data?.accountId;\r",
              "\r",
              "if (newAccountId) {\r",
              "    const existingAccountId = pm.collectionVariables.get(\"accountId\");\r",
              "\r",
              "    if (!existingAccountId) {\r",
              "        pm.collectionVariables.set(\"accountId\", newAccountId);\r",
              "    } else {\r",
              "        pm.collectionVariables.set(\"accountId2\", newAccountId);\r",
              "    }\r",
              "}\r",
              "\r",
              "let acctRunCount = parseInt(pm.collectionVariables.get(\"acctRunCount\") || \"0\");\r",
              "\r",
              "if (acctRunCount < 1) {\r",
              "    pm.collectionVariables.set(\"acctRunCount\", acctRunCount + 1);\r",
              "    pm.execution.setNextRequest(\"accounts\");\r",
              "} else {\r",
              "    pm.collectionVariables.unset(\"acctRunCount\");\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
